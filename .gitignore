# Runtime state -- never commit these. config/config.yaml holds the secret key;
# the bare name also catches a stray copy anywhere else.
config.yaml
data/
*.db

# Compiled output. Built by the Dockerfile, scripts/build.sh, or `go build`.
#
# The trailing negations matter: a bare "/server" also matches the server/
# source directory, which silently keeps the entire backend out of the
# repository. Ignore the binaries, then put the directories back.
/server
!/server/
/manage
!/manage/
/todoboard
/todoboard.exe
dist/

# Go tooling: test binaries, coverage profiles, profiler output, go.work.
*.test
*.out
coverage.html
*.prof
go.work
go.work.sum

# scripts/run.sh's pid file and scripts/run.bat's staged build.
.run/

# Logs and stray temp files.
*.log
*.tmp
*.bak

# Secrets that must never be committed, wherever they turn up. docker/lib.sh
# writes config.yaml.new before moving it into place.
config.yaml.new
.env
.env.*
*.pem
*.key

# OS clutter, in any directory.
.DS_Store
._*
.AppleDouble
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/

# Editors and IDEs.
.idea/
.vscode/
*.swp
*.swo
*~
.#*
\#*\#
*.sublime-workspace
